diff --git a/frappe_assistant_core/tests/test_app_plugin_discovery.py b/frappe_assistant_core/tests/test_app_plugin_discovery.py
new file mode 100644
index 0000000..8004c41
--- /dev/null
+++ b/frappe_assistant_core/tests/test_app_plugin_discovery.py
@@ -0,0 +1,39 @@
+"""Installed apps can provide plugins without modifying the connector package."""
+import logging
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from frappe_assistant_core.plugins.base_plugin import BasePlugin
+from frappe_assistant_core.utils.plugin_manager import PluginDiscovery
+
+
+class AppPlugin(BasePlugin):
+    def get_info(self):
+        return {"name": "example_app", "display_name": "Example", "version": "1.0"}
+
+    def get_tools(self):
+        return ["example_tool"]
+
+    def validate_environment(self):
+        return True, None
+
+
+class TestAppPluginDiscovery(unittest.TestCase):
+    @patch("frappe.logger", return_value=logging.getLogger("test"))
+    def test_hook_preserves_module_path_and_tools(self, logger):
+        discovery = PluginDiscovery()
+        with patch("frappe.get_hooks", return_value=["example_app.assistant"]), patch.object(
+            discovery, "_discover_plugin", return_value=None
+        ), patch("importlib.import_module", return_value=SimpleNamespace(AppPlugin=AppPlugin)):
+            plugins = discovery.discover_plugins()
+        self.assertEqual(plugins["example_app"].module_path, "example_app.assistant")
+        self.assertEqual(plugins["example_app"].tools, ["example_tool"])
+
+    @patch("frappe.logger", return_value=logging.getLogger("test"))
+    def test_broken_app_plugin_does_not_break_discovery(self, logger):
+        discovery = PluginDiscovery()
+        with patch("frappe.get_hooks", return_value=["missing.assistant"]), patch.object(
+            discovery, "_discover_plugin", return_value=None
+        ), patch("importlib.import_module", side_effect=ImportError("missing")):
+            self.assertEqual(discovery.discover_plugins(), {})
